# Backend (FastAPI). In Railway, set these as service variables.

# Supabase transaction pooler, role cobranza_app (RLS enforced, no BYPASSRLS).
DATABASE_URL=postgresql://cobranza_app.<project_ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Public https URL of this service; payment links point here.
PUBLIC_BASE_URL=https://<your-service>.up.railway.app

# HMAC secret of the ElevenLabs post-call webhook (printed once by `scripts/agents.py push`).
POST_CALL_WEBHOOK_SECRET=

# log = print payment links to stdout; live = send through WhatsApp / Telegram.
CHANNEL_MODE=log
PAYMENT_LINK_TTL_HOURS=48

# WhatsApp Cloud API (tenant avanza). Override per tenant with NAME__<TENANT>, e.g. WHATSAPP_ACCESS_TOKEN__AVANZA.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 4 body params: name, amount, due date, link. Empty = free-form text (24h window only).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es

# Telegram bot (tenant nexo).
TELEGRAM_BOT_TOKEN=

# Local only: tests and scripts/agents.py read these. Never deploy them to the backend.
TENANT_KEY_AVANZA=
TENANT_KEY_NEXO=
# Supabase "postgres" connection string; used only by scripts/admin.py and agent registration.
DATABASE_ADMIN_URL=
