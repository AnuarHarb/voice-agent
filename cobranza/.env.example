# scripts/agents.py reads backend/.env first, then this file, then the process environment.

ELEVENLABS_API_KEY=
# Public https URL of the deployed backend; tool webhooks and the post-call webhook point here.
BACKEND_URL=https://<your-service>.up.railway.app

# Tenant keys become ElevenLabs workspace secrets used as the X-Tenant-Key header.
TENANT_KEY_AVANZA=
TENANT_KEY_NEXO=

# Optional
ELEVENLABS_LLM=claude-sonnet-5
ELEVENLABS_VOICE_ID_AVANZA=
ELEVENLABS_VOICE_ID_NEXO=
SESSION_TOKEN_VAR=secret__session_token
DATABASE_ADMIN_URL=
