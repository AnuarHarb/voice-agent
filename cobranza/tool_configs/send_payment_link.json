{
  "type": "webhook",
  "name": "send_payment_link",
  "description": "Sends the payment link for the plan just registered to the customer's ${channel_label}. Call it right after create_payment_plan succeeds.",
  "response_timeout_secs": 20,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "execution_mode": "post_tool_speech",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/tools/payment-link",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": { "secret_id": "${tenant_key_secret_id}" },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["session_token", "plan_ref", "conversation_id"],
      "properties": {
        "plan_ref": { "type": "string", "dynamic_variable": "plan_ref" },
        "session_token": { "type": "string", "dynamic_variable": "${session_var}" },
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" }
      }
    }
  }
}
