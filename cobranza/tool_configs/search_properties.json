{
  "type": "webhook",
  "name": "search_properties",
  "description": "Searches available properties by zone, type, bedrooms and maximum price. Returns up to three; present at most two. No identity verification needed.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/inmo/search",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "conversation_id"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "description": "Neighborhood or zone, for example Chapinero. Empty if not said."
        },
        "kind": {
          "type": "string",
          "enum": [
            "venta",
            "arriendo"
          ],
          "description": "venta for purchase, arriendo for rent. Omit if not said."
        },
        "bedrooms": {
          "type": "integer",
          "description": "Minimum bedrooms. 0 if not said."
        },
        "max_price": {
          "type": "integer",
          "description": "Maximum price in Colombian pesos as a plain number. 0 if not said."
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
