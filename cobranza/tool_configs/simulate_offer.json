{
  "type": "webhook",
  "name": "simulate_offer",
  "description": "Simulates installment, EA rate and total cost. Read spoken_summary verbatim to the customer.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "force",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/tools/simulate-offer",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": { "secret_id": "${tenant_key_secret_id}" },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["conversation_id", "session_token", "offer_id", "term_months"],
      "properties": {
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" },
        "session_token": { "type": "string", "dynamic_variable": "${session_var}" },
        "offer_id": { "type": "string" },
        "term_months": { "type": "integer" }
      }
    }
  }
}
