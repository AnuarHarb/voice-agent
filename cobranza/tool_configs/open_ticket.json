{
  "type": "webhook",
  "name": "open_ticket",
  "description": "Opens a technical-visit ticket. Only after a failed diagnostic and with an agreed description.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/telco/ticket",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "issue",
        "session_token",
        "conversation_id"
      ],
      "properties": {
        "issue": {
          "type": "string",
          "description": "Short description of the failure in Spanish, without personal data."
        },
        "session_token": {
          "type": "string",
          "dynamic_variable": "${session_var}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
