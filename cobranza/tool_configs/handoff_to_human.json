{
  "type": "webhook",
  "name": "handoff_to_human",
  "description": "Registers a handoff to a human advisor: the customer asks for a person, a policy refusal needs a human, or you cannot resolve the request. Works without identity verification. Give the customer the returned reference.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/handoff",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "reason",
        "conversation_id"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "description": "One sentence in Spanish on why a human should follow up, without names, ID numbers or other personal data."
        },
        "session_token": {
          "type": "string",
          "dynamic_variable": "${session_var}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
