{
  "type": "webhook",
  "name": "start_return",
  "description": "Starts a return for a delivered order and sends the label by message. Policy decides eligibility (30 days after delivery); if refused, explain it and offer a human handoff, never an exception.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/retail/return",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "order_no",
        "reason",
        "session_token",
        "conversation_id"
      ],
      "properties": {
        "order_no": {
          "type": "string",
          "description": "Order number such as MN-10110."
        },
        "reason": {
          "type": "string",
          "description": "Why the customer returns it, in Spanish, one short sentence."
        },
        "session_token": {
          "type": "string",
          "dynamic_variable": "${session_var}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
