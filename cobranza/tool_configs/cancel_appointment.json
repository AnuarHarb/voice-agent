{
  "type": "webhook",
  "name": "cancel_appointment",
  "description": "Cancels an appointment. Policy requires 24 hours of notice: if the result says too_late, offer rescheduling or a human handoff, never an exception.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/salud/cancel",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "appointment_ref",
        "session_token",
        "conversation_id"
      ],
      "properties": {
        "appointment_ref": {
          "type": "string",
          "description": "Appointment reference returned by get_my_appointment or book_appointment."
        },
        "session_token": {
          "type": "string",
          "dynamic_variable": "${session_var}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
