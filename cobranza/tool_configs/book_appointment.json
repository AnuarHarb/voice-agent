{
  "type": "webhook",
  "name": "book_appointment",
  "description": "Books the slot the customer chose. To reschedule, pass the old appointment reference in replaces_ref so it is released. Confirm date and specialist out loud before calling.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/verticals/salud/book",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "slot_id",
        "session_token",
        "conversation_id"
      ],
      "properties": {
        "slot_id": {
          "type": "string",
          "description": "slot_id exactly as returned by list_availability."
        },
        "replaces_ref": {
          "type": "string",
          "description": "Reference of the appointment being rescheduled. Empty for a new appointment."
        },
        "session_token": {
          "type": "string",
          "dynamic_variable": "${session_var}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
