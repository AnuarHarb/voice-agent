{
  "type": "webhook",
  "name": "verify_customer",
  "description": "Verifies the caller is the registered customer. Use only inside the identity verification procedure, after collecting the last four digits of the cédula and the birth date. Returns verified true or false; never reveals why it failed.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "force",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "assignments": [
    {
      "source": "response",
      "dynamic_variable": "identity_verified",
      "value_path": "verified"
    },
    {
      "source": "response",
      "dynamic_variable": "identity_incomplete",
      "value_path": "incomplete"
    },
    {
      "source": "response",
      "dynamic_variable": "${session_var}",
      "value_path": "session_token",
      "sanitize": true
    },
    {
      "source": "response",
      "dynamic_variable": "customer_first_name",
      "value_path": "customer_first_name"
    }
  ],
  "api_schema": {
    "url": "${backend_url}/verticals/verify-customer",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": {
        "secret_id": "${tenant_key_secret_id}"
      },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": [
        "id_last4",
        "birth_date",
        "vertical",
        "conversation_id"
      ],
      "properties": {
        "id_last4": {
          "type": "string",
          "description": "Last four digits of the customer's cédula as four digits. Convert spoken digits: \"cuatro cuatro uno siete\" -> \"4417\"."
        },
        "birth_date": {
          "type": "string",
          "description": "Customer's birth date in YYYY-MM-DD format. Convert \"catorce de mayo de mil novecientos noventa\" -> \"1990-05-14\"."
        },
        "vertical": {
          "type": "string",
          "constant_value": "${vertical}"
        },
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        }
      }
    }
  }
}
