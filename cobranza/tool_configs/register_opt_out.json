{
  "type": "webhook",
  "name": "register_opt_out",
  "description": "Records that the customer does not want to be contacted again for collections (Ley 2300). Call it immediately when asked, with or without identity verification. If linked_to_account is false, offer to verify identity so it applies to their account.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "execution_mode": "post_tool_speech",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/tools/opt-out",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": { "secret_id": "${tenant_key_secret_id}" },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["conversation_id"],
      "properties": {
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" }
      }
    }
  }
}
