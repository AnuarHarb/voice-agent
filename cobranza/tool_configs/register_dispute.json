{
  "type": "webhook",
  "name": "register_dispute",
  "description": "Registers a dispute when the verified customer says the debt is wrong, not theirs, or already paid. Pauses collection and returns a case_ref. Do not argue with the customer.",
  "response_timeout_secs": 15,
  "pre_tool_speech": "auto",
  "tool_call_sound": "typing",
  "tool_call_sound_behavior": "always",
  "tool_error_handling_mode": "hide",
  "api_schema": {
    "url": "${backend_url}/tools/disputes",
    "method": "POST",
    "request_headers": {
      "X-Tenant-Key": { "secret_id": "${tenant_key_secret_id}" },
      "X-Tenant-Id": "${tenant_id}"
    },
    "request_body_schema": {
      "type": "object",
      "required": ["session_token", "reason", "conversation_id"],
      "properties": {
        "reason": {
          "type": "string",
          "description": "One sentence in Spanish summarizing why the customer disputes the debt, without names, ID numbers or other personal data."
        },
        "session_token": { "type": "string", "dynamic_variable": "${session_var}" },
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" }
      }
    }
  }
}
